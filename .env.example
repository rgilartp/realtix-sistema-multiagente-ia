# Variables de entorno del sistema multiagente de IA (RNF-14 · Configuración por entorno).
#
# Uso: cp .env.example .env  y llene los valores. El archivo .env nunca se versiona.
# En .env van solo los secretos y lo propio de cada máquina. Los parámetros (umbral, pesos,
# horario y tiempos) tienen su valor por defecto en src/config.py; aquí aparecen comentados
# solo como referencia.
# Los secretos propios se generan con:  openssl rand -hex 32

# --- Modelos (ADR-02) -------------------------------------------------------------------
# Clave de la API de Anthropic del sistema multiagente de IA (console.anthropic.com).
# Se llama REALTIX_ANTHROPIC_API_KEY a propósito: nunca use ANTHROPIC_API_KEY.
REALTIX_ANTHROPIC_API_KEY=
# Clave de la API de OpenAI, solo para los embeddings (platform.openai.com).
OPENAI_API_KEY=
# Modelo de cada nodo; se cambian sin tocar el código (RF-SYS-04).
# MODELO_ORQUESTADOR=claude-sonnet-5-5
# MODELO_IPU=claude-haiku-5-5
# MODELO_ICA=claude-haiku-5-5
# MODELO_GENERAL=claude-haiku-5-5
# MODELO_OCR=claude-haiku-5-5
# MODELO_JUEZ=claude-opus-5-5
# MODELO_EMBEDDINGS=text-embedding-3-large

# --- Observabilidad (ADR-11) ------------------------------------------------------------
# Clave de LangSmith (smith.langchain.com). Opcional hasta B5.
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=realtix-sistema-multiagente-ia
LANGSMITH_TRACING=false

# --- Datos (ADR-05) ---------------------------------------------------------------------
# Base sintética de RealSit (SQLite, se abre en solo lectura). La genera B3.
REALSIT_DB_PATH=datos/realsit_sintetico.db
# Credenciales del contenedor postgres de docker-compose.yml (desarrollo local).
POSTGRES_USER=realtix
POSTGRES_PASSWORD=realtix_dev
POSTGRES_DB=realtix
# Conexión al almacén propio y al checkpointer. Debe coincidir con las tres anteriores.
DATABASE_URL=postgresql://realtix:realtix_dev@localhost:5432/realtix
CHROMA_HOST=localhost
CHROMA_PORT=8000

# --- Confianza y enrutamiento (ADR-17) --------------------------------------------------
# UMBRAL_CONFIANZA=0.7
# PESO_SIMILITUD=0.4
# PESO_SUFICIENCIA=0.4
# PESO_COBERTURA=0.2
# MAX_RECLASIFICACIONES=2

# --- Tiempos máximos, en segundos (RNF-08) ----------------------------------------------
# TIMEOUT_MODELO_S=20
# TIMEOUT_CHROMA_S=5
# TIMEOUT_ADAPTADOR_S=5

# --- Seguridad --------------------------------------------------------------------------
# Secreto con el que se firman los tokens de la OVT simulada (HMAC-SHA256). openssl rand -hex 32
OVT_HMAC_SECRET=
# Token de la bandeja del funcionario en la consola. openssl rand -hex 32
TOKEN_FUNCIONARIO=
# Token de las métricas del administrador en la consola. openssl rand -hex 32
TOKEN_ADMIN=
# Orígenes permitidos por CORS, separados por comas.
CORS_ORIGENES=http://localhost:5173
# Activa POST /api/v1/ovt-simulada/sesion (ADR-07).
OVT_SIMULADA_ACTIVA=true

# --- Horario y evaluación (RNF-06 y ADR-16) ---------------------------------------------
# HORARIO_INICIO=08:00
# HORARIO_FIN=17:00
# ZONA_HORARIA=America/Bogota
# Reloj simulado (X-Reloj-Simulado) y X-Escenario-Id; apagado por defecto.
MODO_EVALUACION=false
# Fallas inyectables por encabezado de prueba; apagado por defecto.
FALLAS_INYECTABLES=false

# --- Archivos (RF-OCR-01) ---------------------------------------------------------------
# TAMANO_MAXIMO_ARCHIVO_MB=5
