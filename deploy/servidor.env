# Configuración no secreta del servidor (sección 3.10; RNF-14 · Configuración por entorno).
# Versionada. Los secretos están solo en el .env de Rodolfo, que se copia sin cambios; lo de este
# archivo tiene prioridad sobre el .env. Compose la lee también para armar los valores del proxy
# (`--env-file .env --env-file deploy/servidor.env`, como en deploy/desplegar.sh).
DOMINIO=tg2-multiagente.duckdns.org
OVT_SIMULADA_ACTIVA=true
VIGENCIA_ACTUAL=2026
# Confianza (ADR-17): umbral revisado en B15 con las corridas 1 y 2 y aprobado por Rodolfo (0,70).
UMBRAL_CONFIANZA=0.7
PESO_SIMILITUD=0.4
PESO_SUFICIENCIA=0.4
PESO_COBERTURA=0.2
