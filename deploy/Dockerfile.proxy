# Imagen del proxy (ADR-09; sección 3.7): compila la web (OVT simulada, widget y consola) con Vite
# y la sirve con Caddy 2.11, que además da HTTPS automático y pasa /api y /health al backend.

FROM node:24-slim AS web
WORKDIR /web
COPY web/package.json web/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY web/ ./
RUN npm run build

FROM caddy:2.11
COPY deploy/Caddyfile /etc/caddy/Caddyfile
COPY --from=web /web/dist /srv
