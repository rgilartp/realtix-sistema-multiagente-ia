{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "opusplan",
  "permissions": {
    "defaultMode": "plan",
    "allow": [
      "Bash(uv *)",
      "Bash(pytest *)",
      "Bash(ruff *)",
      "Bash(pre-commit *)",
      "Bash(docker *)",
      "Bash(docker compose *)",
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(git *)",
      "Bash(gh pr create *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr merge *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh issue *)",
      "Bash(gh run *)",
      "Bash(gh api *)",
      "Bash(ssh -i ~/.ssh/tg2-ec2.pem *)",
      "Bash(scp -i ~/.ssh/tg2-ec2.pem *)",
      "WebFetch(domain:www.secretariasenado.gov.co)",
      "WebFetch(domain:secretariasenado.gov.co)",
      "WebFetch(domain:normativa.colpensiones.gov.co)",
      "WebFetch(domain:www.cancilleria.gov.co)",
      "WebFetch(domain:cancilleria.gov.co)",
      "WebFetch(domain:www.funcionpublica.gov.co)",
      "WebFetch(domain:www.ambitojuridico.com)",
      "WebFetch(domain:bogota.gov.co)",
      "WebFetch(domain:www.igac.gov.co)",
      "WebFetch(domain:www.haciendabogota.gov.co)",
      "WebFetch(domain:incp.org.co)",
      "WebFetch(domain:www.alcaldiabogota.gov.co)",
      "WebFetch(domain:www.dane.gov.co)",
      "WebFetch(domain:sedeelectronica.sic.gov.co)",
      "WebFetch(domain:legalinstruments.oecd.org)",
      "WebFetch(domain:platform.claude.com)",
      "WebFetch(domain:docs.anthropic.com)",
      "WebFetch(domain:code.claude.com)",
      "WebFetch(domain:docs.langchain.com)",
      "WebFetch(domain:python.langchain.com)",
      "WebFetch(domain:langchain-ai.github.io)",
      "WebFetch(domain:docs.trychroma.com)",
      "WebFetch(domain:docs.ragas.io)",
      "WebFetch(domain:fastapi.tiangolo.com)",
      "WebFetch(domain:docs.pydantic.dev)",
      "WebFetch(domain:docs.astral.sh)",
      "WebFetch(domain:pypi.org)",
      "WebFetch(domain:caddyserver.com)",
      "WebFetch(domain:docs.aws.amazon.com)",
      "WebFetch(domain:vite.dev)",
      "WebFetch(domain:tailwindcss.com)",
      "WebFetch(domain:react.dev)",
      "WebFetch(domain:docs.github.com)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./deploy/.env)",
      "Bash(cat .env)",
      "Bash(cat * .env)",
      "Bash(cat ./.env)",
      "Bash(cat * ./.env)",
      "Bash(cat .env.local)",
      "Bash(cat * .env.local)",
      "Bash(cat deploy/.env)",
      "Bash(cat * deploy/.env)",
      "Bash(head .env)",
      "Bash(head * .env)",
      "Bash(head ./.env)",
      "Bash(head * ./.env)",
      "Bash(head .env.local)",
      "Bash(head * .env.local)",
      "Bash(head deploy/.env)",
      "Bash(head * deploy/.env)",
      "Bash(tail .env)",
      "Bash(tail * .env)",
      "Bash(tail ./.env)",
      "Bash(tail * ./.env)",
      "Bash(tail .env.local)",
      "Bash(tail * .env.local)",
      "Bash(tail deploy/.env)",
      "Bash(tail * deploy/.env)",
      "Bash(less .env)",
      "Bash(less * .env)",
      "Bash(less ./.env)",
      "Bash(less * ./.env)",
      "Bash(less .env.local)",
      "Bash(less * .env.local)",
      "Bash(less deploy/.env)",
      "Bash(less * deploy/.env)",
      "Bash(more .env)",
      "Bash(more * .env)",
      "Bash(more ./.env)",
      "Bash(more * ./.env)",
      "Bash(more .env.local)",
      "Bash(more * .env.local)",
      "Bash(more deploy/.env)",
      "Bash(more * deploy/.env)",
      "Bash(source .env)",
      "Bash(source * .env)",
      "Bash(source ./.env)",
      "Bash(source * ./.env)",
      "Bash(source .env.local)",
      "Bash(source * .env.local)",
      "Bash(source deploy/.env)",
      "Bash(source * deploy/.env)",
      "Bash(grep * .env)",
      "Bash(grep * ./.env)",
      "Bash(grep * deploy/.env)",
      "Read(~/.ssh/**)",
      "Bash(cat ~/.ssh/*)",
      "Bash(head ~/.ssh/*)",
      "Bash(tail ~/.ssh/*)",
      "Bash(less ~/.ssh/*)",
      "Bash(grep * ~/.ssh/*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f)",
      "Bash(git push origin main*)",
      "Bash(git push * main)",
      "Bash(git push * HEAD:main)",
      "Bash(git commit --no-verify*)",
      "Bash(git commit * --no-verify*)",
      "Bash(git commit -n *)",
      "Bash(git commit --no-gpg-sign*)",
      "Bash(git commit * --no-gpg-sign*)",
      "Bash(gh repo delete*)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "Bash(rm -rf ..*)",
      "Bash(git push *:main)",
      "Bash(git push *:refs/heads/main)",
      "Bash(gh api -X DELETE *)",
      "Bash(gh api --method DELETE *)",
      "Bash(gh api * -X DELETE *)",
      "Bash(gh api * --method DELETE *)",
      "Bash(rm -rf $HOME*)",
      "Bash(rm -rf ${HOME}*)"
    ]
  }
}
